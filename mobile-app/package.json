{
  "name": "windworld-mobile-app",
  "private": true,
  "version": "0.1.0",
  "main": "expo/AppEntry",
  "scripts": {
    "check": "node scripts/check-navigation-styles.js && tsc --noEmit",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "android:clear": "expo start --android --clear",
    "build:apk": "npx eas-cli@latest build --platform android --profile apk",
    "build:aab": "npx eas-cli@latest build --platform android --profile production",
    "update:preview": "npx eas-cli@latest update --platform android --channel preview",
    "update:production": "npx eas-cli@latest update --platform android --channel production",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "^58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-font": "~58.0.11",
    "expo-location": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  }
}
