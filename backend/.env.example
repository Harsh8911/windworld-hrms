NODE_ENV=development
PORT=5003
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

DB_HOST=localhost
DB_PORT=5432
DB_NAME=windworld
DB_USER=postgres
DB_PASSWORD=hg
DB_SSL=false
DB_POOL_MAX=10

# Replace both secrets with independent random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=windworld-api
JWT_AUDIENCE=windworld-mobile

# Used only by `npm run db:seed:admin`.
ADMIN_SEED_EMAIL=admin@windworld.com
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_FULL_NAME=WindWorld Administrator
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
